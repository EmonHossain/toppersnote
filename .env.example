# Copy this file to .env for local development.
# Never commit real secrets, production passwords, or cloud credentials.

# Application
APP_NAME=sharenote
SERVER_PORT=8080
API_BASE_PATH=/api/v1

# Database
DB_URL=jdbc:h2:mem:sharenote;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DB_DRIVER=org.h2.Driver
DB_USERNAME=sa
DB_PASSWORD=

# Optional MySQL Docker Compose profile values.
# Use these when switching DB_URL from H2 to MySQL.
MYSQL_DATABASE=sharenote
MYSQL_USER=sharenote
MYSQL_PASSWORD=sharenote-dev-secret
MYSQL_ROOT_PASSWORD=sharenote-root-secret
MYSQL_PORT=3306

# JPA
JPA_DDL_AUTO=update
JPA_OPEN_IN_VIEW=false
JPA_SHOW_SQL=false
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
QUARTZ_AUTO_STARTUP=true
EXAM_REMINDER_CRON=0 0 8 * * ?
EXAM_REMINDER_DAYS_BEFORE=7
NOTE_RETENTION_YEARS=5
NOTE_RETENTION_NOTICE_LEAD_DAYS=30
NOTE_RETENTION_BATCH_SIZE=50
NOTE_RETENTION_AUTO_DELETE_ENABLED=true
NOTE_RETENTION_SCAN_CRON=0 0 2 * * ?
NOTE_RETENTION_NOTICE_CRON=0 15 2 * * ?
NOTE_RETENTION_REMOVAL_CRON=0 30 2 * * ?
NOTE_RETENTION_NOTE_LINK_BASE_URL=/api/v1

# Local development tools
H2_CONSOLE_ENABLED=true
OPENAPI_DOCS_ENABLED=true
SWAGGER_UI_ENABLED=true

# Redis cache profile
CACHE_TYPE=simple
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2s
REDIS_HEALTH_ENABLED=false

# Elasticsearch search profile
ELASTICSEARCH_URIS=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_CONNECTION_TIMEOUT=2s
ELASTICSEARCH_SOCKET_TIMEOUT=5s
ELASTICSEARCH_HEALTH_ENABLED=false
ELASTICSEARCH_HTTP_PORT=9200
ELASTICSEARCH_TRANSPORT_PORT=9300
KIBANA_PORT=5601
NOTE_SEARCH_INDEX_NAME=sharenote-notes
NOTE_SEARCH_DEFAULT_LIMIT=20
NOTE_SEARCH_MAX_LIMIT=50
SEARCH_RESILIENCE_FAILURE_RATE_THRESHOLD=50
SEARCH_RESILIENCE_SLIDING_WINDOW_SIZE=10
SEARCH_RESILIENCE_MINIMUM_CALLS=5
SEARCH_RESILIENCE_OPEN_STATE_DURATION=30s
SEARCH_RESILIENCE_RETRY_MAX_ATTEMPTS=2
SEARCH_RESILIENCE_RETRY_WAIT_DURATION=200ms

# Observability
ACTUATOR_EXPOSED_ENDPOINTS=health,info,metrics,prometheus
ACTUATOR_HEALTH_SHOW_DETAILS=when_authorized
PROMETHEUS_METRICS_ENABLED=true
OTLP_METRICS_ENABLED=false
OTLP_METRICS_URL=http://localhost:4318/v1/metrics
OTLP_METRICS_STEP=30s
OTEL_TRACING_ENABLED=false
OTEL_TRACES_SAMPLING_PROBABILITY=1.0
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
OTEL_COLLECTOR_PROMETHEUS_PORT=9464
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# JWT
# Use a long random value in every real environment.
# Example generator: openssl rand -base64 64
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-bytes-long
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# Upload limits
MULTIPART_MAX_FILE_SIZE=10MB
MULTIPART_MAX_REQUEST_SIZE=10MB

# Note storage
# NOTE_STORAGE_TYPE can be local or s3.
NOTE_STORAGE_TYPE=local
NOTE_STORAGE_DIRECTORY=uploads/notes
NOTE_MAX_FILE_SIZE_BYTES=10485760

# S3 note storage
# Required only when NOTE_STORAGE_TYPE=s3.
NOTE_STORAGE_S3_BUCKET=
NOTE_STORAGE_S3_PREFIX=notes
NOTE_STORAGE_S3_REGION=us-east-1
NOTE_STORAGE_S3_ENDPOINT=
NOTE_STORAGE_S3_PATH_STYLE_ACCESS=false
NOTE_STORAGE_S3_ACCESS_KEY=
NOTE_STORAGE_S3_SECRET_KEY=

# Profile picture storage
# PROFILE_PICTURE_STORAGE_TYPE can be local or s3.
PROFILE_PICTURE_STORAGE_TYPE=local
PROFILE_PICTURE_STORAGE_DIRECTORY=uploads/profile-pictures
PROFILE_PICTURE_MAX_FILE_SIZE_BYTES=5242880

# S3 profile picture storage
# Required only when PROFILE_PICTURE_STORAGE_TYPE=s3.
PROFILE_PICTURE_STORAGE_S3_BUCKET=
PROFILE_PICTURE_STORAGE_S3_PREFIX=profile-pictures
PROFILE_PICTURE_STORAGE_S3_REGION=us-east-1
PROFILE_PICTURE_STORAGE_S3_ENDPOINT=
PROFILE_PICTURE_STORAGE_S3_PATH_STYLE_ACCESS=false
PROFILE_PICTURE_STORAGE_S3_ACCESS_KEY=
PROFILE_PICTURE_STORAGE_S3_SECRET_KEY=

# Local MinIO test credentials for S3 flows.
# Use endpoint http://localhost:9000 when running the app outside Docker.
# Use endpoint http://minio:9000 when running the app inside Docker Compose.
MINIO_ROOT_USER=sharenote
MINIO_ROOT_PASSWORD=sharenote-dev-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Email verification
# .edu domains are always allowed. Add comma-separated institution domains for non-.edu schools.
EMAIL_VERIFICATION_TOKEN_EXPIRATION_MINUTES=60
EMAIL_VERIFICATION_BASE_URL=http://localhost:8080
EMAIL_VERIFICATION_ALLOWED_DOMAINS=
EMAIL_VERIFICATION_DELIVERY=log
EMAIL_VERIFICATION_FROM_ADDRESS=no-reply@sharenote.local
EMAIL_VERIFICATION_SUBJECT=Verify your ShareNote email

# Kafka email delivery. Set EMAIL_VERIFICATION_DELIVERY=kafka to publish after DB commit.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=sharenote-api
KAFKA_PORT=9092
KAFKA_DELIVERY_TIMEOUT_MS=30000
KAFKA_REQUEST_TIMEOUT_MS=10000
EMAIL_VERIFICATION_KAFKA_TOPIC=sharenote.email-verification
EMAIL_VERIFICATION_KAFKA_DLT=sharenote.email-verification.dlt
EMAIL_VERIFICATION_KAFKA_CONSUMER_GROUP=sharenote-email-verification
EMAIL_VERIFICATION_KAFKA_PARTITIONS=3
EMAIL_VERIFICATION_KAFKA_REPLICATION_FACTOR=1
EMAIL_VERIFICATION_KAFKA_RETENTION_MS=86400000
EMAIL_VERIFICATION_KAFKA_RETRY_ATTEMPTS=3
EMAIL_VERIFICATION_KAFKA_RETRY_BACKOFF_MS=1000

# SMTP email delivery, used directly for smtp mode and by the Kafka consumer.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS_ENABLE=true
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=5000
SMTP_WRITE_TIMEOUT_MS=5000

# Optional Mailpit Docker Compose profile ports.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_MAX_MESSAGES=5000

# AI provider integration. API keys are supplied per request and are not stored.
AI_MAX_PROMPT_CHARS=4000
AI_MAX_ATTACHMENT_BYTES=10485760
AI_REQUEST_TIMEOUT_SECONDS=30
AI_OPENAI_BASE_URL=https://api.openai.com
AI_ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_GOOGLE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
AI_XAI_BASE_URL=https://api.x.ai

# Logging context keys
TRACE_ID_KEY=trace_id
TENANT_ID_KEY=tenant_id
USER_ID_KEY=user_id
CLIENT_IP_KEY=client_ip
LOGGING_LEVEL_ROOT=INFO
LOG_FILE=logs/sharenote.log
LOGGING_STRUCTURED_FILE_FORMAT=ecs
LOGGING_STRUCTURED_CONSOLE_FORMAT=ecs
FILEBEAT_ELASTICSEARCH_HOSTS=http://elasticsearch:9200
FILEBEAT_KIBANA_HOST=http://kibana:5601
FILEBEAT_INDEX_NAME=sharenote-ecs

# Analytics dashboard defaults
ANALYTICS_DEFAULT_WINDOW_DAYS=7
ANALYTICS_MAX_WINDOW_DAYS=90
ANALYTICS_MAX_RESULT_LIMIT=50
ANALYTICS_TRACKING_ENABLED=true

# Study group activity feed
STUDY_GROUP_ACTIVITY_DEFAULT_LIMIT=20
STUDY_GROUP_ACTIVITY_MAX_LIMIT=50

# Personal study dashboard
DASHBOARD_MAX_CLASSES=10
DASHBOARD_MAX_UPCOMING_EXAMS=5
DASHBOARD_MAX_RECOMMENDED_NOTES=8
DASHBOARD_RECOMMENDATION_CANDIDATE_LIMIT=30
DASHBOARD_MAX_RECENT_NOTIFICATIONS=8
DASHBOARD_MAX_UNREAD_SUGGESTIONS=5
DASHBOARD_MAX_ACTIVE_STUDY_GROUPS=6
DASHBOARD_ANALYTICS_WINDOW_DAYS=7

# Note quality scoring
# Scores are persisted in the database and refreshed on hot reads when stale.
# Redis is not required for this DB-backed scoring pass.
NOTE_QUALITY_ANALYTICS_WINDOW_DAYS=30
NOTE_QUALITY_MAX_RESULT_LIMIT=50
NOTE_QUALITY_RECALCULATION_MAX_AGE_MINUTES=60
NOTE_QUALITY_UPVOTE_WEIGHT=5
NOTE_QUALITY_DOWNLOAD_WEIGHT=3
NOTE_QUALITY_VIEW_WEIGHT=1
NOTE_QUALITY_PREVIEW_WEIGHT=6
NOTE_QUALITY_VERSION_WEIGHT=2
NOTE_QUALITY_FRESHNESS_WEIGHT=1
NOTE_QUALITY_MAX_FRESHNESS_DAYS=14
NOTE_QUALITY_ACTIVE_REPORT_PENALTY=10

# AWS credentials are intentionally not mapped into Spring properties.
# The AWS SDK reads the standard provider chain:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
